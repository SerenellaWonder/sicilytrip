generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELED
}

enum HotelSearchStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ProviderBookingStatus {
  PENDING
  CONFIRMED
  FAILED
  UNCERTAIN
}

model Hotel {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  destinationId    String
  country          String   @default("IT")
  shortDescription String?
  longDescription  String?
  address          String?
  latitude         Float?
  longitude        Float?
  starRating       Int?
  mainImageUrl     String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id])

  apiMappings    HotelApiMapping[]
  bookings       Booking[]
  municipality   Municipality?     @relation(fields: [municipalityId], references: [id])
  municipalityId String?

  @@index([destinationId])
}

model HotelApiMapping {
  id              String   @id @default(cuid())
  hotelId         String
  provider        String
  providerHotelId String
  rawPayload      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@unique([provider, providerHotelId])
}

model RoomCache {
  id          String   @id @default(cuid())
  hotelId     String
  provider    String
  roomCode    String
  roomName    String
  description String?
  capacity    Int?
  rawPayload  Json?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([hotelId, provider])
}

model RateCache {
  id                 String   @id @default(cuid())
  hotelId            String
  provider           String
  rateKey            String
  roomCode           String?
  boardCode          String?
  priceAmount        Decimal  @db.Decimal(10, 2)
  currency           String
  cancellationPolicy String?
  rawPayload         Json?
  expiresAt          DateTime
  createdAt          DateTime @default(now())

  @@index([hotelId, provider])
  @@index([rateKey])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String?
  lastName  String?
  language  String?  @default("it")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id                String        @id @default(cuid())
  userId            String
  hotelId           String
  provider          String
  providerBookingId String?
  status            BookingStatus @default(PENDING)
  checkIn           DateTime
  checkOut          DateTime
  guests            Int
  totalAmount       Decimal       @db.Decimal(10, 2)
  currency          String
  customerEmail     String
  rawPayload        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel    Hotel     @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  payments Payment[]
}

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String
  stripePaymentIntentId String?       @unique
  amount                Decimal       @db.Decimal(10, 2)
  currency              String
  status                PaymentStatus
  rawPayload            Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Experience {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  city        String?
  priceFrom   Decimal? @db.Decimal(10, 2)
  currency    String?  @default("EUR")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Package {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  hotelId   String
  createdAt DateTime @default(now())

  @@unique([userId, hotelId])
}

model ApiLog {
  id           String   @id @default(cuid())
  provider     String
  endpoint     String
  method       String
  statusCode   Int?
  latencyMs    Int?
  requestBody  Json?
  responseBody Json?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([provider, createdAt])
}

model Region {
  id   String @id @default(cuid())
  name String
  slug String @unique
  code String @unique

  provinces Province[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Province {
  id String @id @default(cuid())

  regionId String

  name String
  code String
  slug String @unique

  region Region @relation(fields: [regionId], references: [id])

  municipalities Municipality[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Municipality {
  id String @id @default(cuid())

  provinceId String

  istatCode String @unique

  name String
  slug String @unique

  postalCode String?

  latitude  Float?
  longitude Float?

  province Province @relation(fields: [provinceId], references: [id])

  destinations Destination[]
  hotels       Hotel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Destination {
  id String @id @default(cuid())

  municipalityId String

  name String
  slug String @unique

  shortDescription String?
  description      String?

  latitude  Float?
  longitude Float?

  seoTitle       String?
  seoDescription String?
  coverImage     String?

  featured Boolean @default(false)
  isActive Boolean @default(true)

  municipality Municipality @relation(fields: [municipalityId], references: [id])

  hotels Hotel[]

  hotelSearches HotelSearch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HotelSearch {
  id String @id @default(cuid())

  provider String

  providerSearchId String @unique

  destinationId String?

  destination Destination? @relation(fields: [destinationId], references: [id])

  checkIn DateTime

  checkOut DateTime

  rooms Json

  status HotelSearchStatus @default(PENDING)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  results          HotelSearchResult[]
  bookingAttempts  ProviderBookingAttempt[]
  preBookSnapshots HotelPreBookSnapshot[]
}

model HotelPreBookSnapshot {
  id String @id @default(cuid())

  hotelSearchId   String
  providerHotelId String
  roomId          String

  purchaseToken    String
  spui             String
  originalCurrency String
  deadlineDate     String
  finalPrice       Decimal? @db.Decimal(10, 2)
  providerResponse Json
  expiresAt        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotelSearch HotelSearch   @relation(fields: [hotelSearchId], references: [id], onDelete: Cascade)
  payment     HotelPayment?

  @@unique([hotelSearchId, roomId])
  @@index([expiresAt])
}

model HotelPayment {
  id String @id @default(cuid())

  preBookSnapshotId     String        @unique
  stripePaymentIntentId String        @unique
  amount                Int
  currency              String
  customerEmailHash     String
  status                PaymentStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preBookSnapshot HotelPreBookSnapshot @relation(fields: [preBookSnapshotId], references: [id], onDelete: Restrict)

  @@index([customerEmailHash])
  @@index([status])
}

model ProviderBookingAttempt {
  id String @id @default(cuid())

  hotelSearchId    String
  providerSearchId String
  providerHotelId  String
  giataId          String
  roomId           String

  status            ProviderBookingStatus @default(PENDING)
  referenceCode     String?
  providerError     String?
  customerEmailHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotelSearch HotelSearch @relation(fields: [hotelSearchId], references: [id], onDelete: Restrict)

  @@unique([providerSearchId, roomId])
  @@index([hotelSearchId])
  @@index([referenceCode])
  @@index([customerEmailHash])
}

model CustomerAccessCode {
  id String @id @default(cuid())

  emailHash String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  createdAt DateTime @default(now())

  @@index([emailHash, createdAt])
}

model CustomerSession {
  id String @id @default(cuid())

  emailHash String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([emailHash])
}

model HotelSearchResult {
  id String @id @default(cuid())

  hotelSearchId String

  provider String

  providerHotelId String

  supplier String?

  hotelName String

  stars Int?

  price Decimal? @db.Decimal(10, 2)

  currency String?

  payload Json

  createdAt DateTime @default(now())

  hotelSearch HotelSearch @relation(fields: [hotelSearchId], references: [id], onDelete: Cascade)

  @@index([hotelSearchId])
  @@index([providerHotelId])
  @@index([provider])
}

model HotelDetail {
  id String @id @default(cuid())

  provider String

  providerHotelId String @unique

  name String

  stars Int?

  category String?

  zone String?

  latitude Float?

  longitude Float?

  address String?

  photoGallery Json?

  descriptions Json?

  facilities Json?

  payload Json

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([provider])
}
